<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/header', { pageTitle: "SynergyPro Consulting | Drive Your Success" }) %>
</head>
<body>
    <%- include('partials/navbar', { content: typeof content !== 'undefined' ? content : {} }) %>

    <% if (typeof content !== 'undefined' && content && content.hero) { %>
        <%- include('partials/hero', { hero: content.hero }) %>
        <%- include('partials/services', { services: content.services }) %>
        <%- include('partials/products', { products: content.products }) %>
        <%- include('partials/clients', { clients: content.clients }) %>
        <%- include('partials/testimonials', { testimonials: content.testimonials }) %>
    <% } else { %>
        <div class="section"><h2 style="text-align: center; color: var(--error-text);">Error Loading Page Content</h2><p style="text-align: center;"><%= typeof error !== 'undefined' ? error : 'Could not retrieve website content.' %></p></div>
    <% } %>

    <%- include('partials/contact_form') %>

    <%- include('partials/footer', { current_year: typeof content !== 'undefined' && content ? content.current_year : null }) %>

    <script src="/js/script.js"></script>
</body>
</html>