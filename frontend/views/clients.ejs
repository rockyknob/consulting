<div class="section section-shaded client-section" id="clients"> <%# Ensure 'section' and 'client-section' classes are present %>
    <h2>Trusted by Industry Leaders</h2>
    <div class="marquee">
        <div class="marquee-content">
            <% if (typeof clients !== 'undefined' && clients.length > 0) { %>
                <% clients.forEach(client => { %>
                    <img src="<%= client.logo %>" class="client-logo" title="<%= client.name %>" alt="<%= client.name %> Logo">
                <% }); %>
                <%# Duplicate for smooth scroll %>
                <% clients.forEach(client => { %>
                    <img src="<%= client.logo %>" class="client-logo" title="<%= client.name %>" alt="<%= client.name %> Logo">
                <% }); %>
            <% } else { %>
                 <p style="color: var(--text-medium); padding: 1rem;">Client logos currently unavailable.</p> <%# Added fallback message %>
            <% } %>
        </div>
    </div>
</div>