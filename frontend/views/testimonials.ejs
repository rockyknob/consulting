<div class="section section-shaded" id="testimonials">
    <h2>Driving Client Success</h2>
    <p class="text-center" style="max-width: 700px; margin: -2rem auto 3rem auto;">
        Hear directly from leaders about the impact of our partnership and solutions.
    </p>

    <% if (typeof testimonials !== 'undefined' && testimonials.length > 0) { %>
        <div class="swiper testimonial-swiper">
            <div class="swiper-wrapper">
                <%# --- LOOP 1 --- %>
                <% testimonials.forEach((testimonial, index) => { %>
                    <div class="swiper-slide testimonial-card">
                        <div class="testimonial-avatar" style="background-image: url('/images/avatar-placeholder.png');"></div>
                        <p>"<%= testimonial.quote %>"</p>
                        <div class="testimonial-author-info">
                            <div class="testimonial-author"><%= testimonial.author %></div>
                            <div class="testimonial-title"><%= testimonial.title %></div>
                        </div>
                    </div>
                <% }); %>

                <%# --- LOOP 2 (Duplicate Slides for Loop Mode) --- %>
                <% testimonials.forEach((testimonial, index) => { %>
                    <div class="swiper-slide testimonial-card">
                        <div class="testimonial-avatar" style="background-image: url('/images/avatar-placeholder.png');"></div>
                        <p>"<%= testimonial.quote %>"</p>
                        <div class="testimonial-author-info">
                            <div class="testimonial-author"><%= testimonial.author %></div>
                            <div class="testimonial-title"><%= testimonial.title %></div>
                        </div>
                    </div>
                <% }); %>
                <%# --- End Duplication --- %>

            </div>
            <div class="swiper-pagination testimonial-pagination"></div>
            <div class="swiper-button-prev testimonial-button-prev"></div>
            <div class="swiper-button-next testimonial-button-next"></div>
        </div>
    <% } else { %>
        <p class="text-center">Testimonials currently unavailable.</p>
    <% } %>
</div>