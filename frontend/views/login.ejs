<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/header', { pageTitle: pageTitle || "Sign In" }) %>
    <style>
        .auth-container { max-width: 450px; margin: 4rem auto; padding: 2.5rem; background-color: var(--white); border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); border: 1px solid var(--border-color-light); }
        .auth-container h2 { text-align: center; margin-bottom: 1.5rem; color: var(--primary-blue); }
        .auth-form label { display: block; margin-bottom: 0.5rem; font-weight: 500; color: var(--text-medium); }
        .auth-form input[type="email"], .auth-form input[type="password"] { width: 100%; padding: 12px 15px; margin-bottom: 1rem; border: 1px solid var(--border-color); border-radius: 4px; font-size: 1rem; }
        .auth-form input:focus { border-color: var(--google-blue); box-shadow: 0 0 0 1px var(--google-blue); outline: none;}
        .auth-options { text-align: center; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color-light); font-size: 0.9em;}
        .auth-options p { margin-bottom: 1rem; }
        .auth-options a { margin: 0 0.5rem; text-decoration: underline;}
        .oauth-buttons a { display: block; margin-bottom: 0.75rem; padding: 10px; border-radius: 4px; text-decoration: none; text-align: center; font-weight: 500; transition: opacity 0.2s ease;}
        .oauth-buttons a:hover { opacity: 0.9; }
        .oauth-google { background-color: #4285F4; color: white;}
        .oauth-linkedin { background-color: #0A66C2; color: white;}
        .oauth-github { background-color: #333; color: white;}
        .flash-message { padding: 1rem; margin-bottom: 1.5rem; border-radius: 4px; text-align: center; font-weight: 500;}
        .flash-error { background-color: var(--error-bg); color: var(--error-text); border: 1px solid var(--error-border); }
        .flash-success { background-color: var(--success-bg); color: var(--success-text); border: 1px solid var(--success-border); }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="section">
        <div class="auth-container">
            <h2>Sign In</h2>

            <% if (message && message.length > 0) { %>
                 <div class="flash-message flash-error"><%= message %></div>
            <% } %>
            


            <form action="/login" method="POST" class="auth-form">
                <div>
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" required autofocus>
                </div>
                <div>
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required>
                </div>
                <button type="submit" class="button button-primary" style="width: 100%; margin-top: 1rem;">Sign In</button>
            </form>

            <div class="auth-options">
                 <p>Or sign in using:</p>
                 <div class="oauth-buttons">
                    <a href="/auth/google" class="oauth-google"><i class="fab fa-google"></i> Google</a>
                    <a href="/auth/linkedin" class="oauth-linkedin"><i class="fab fa-linkedin"></i> LinkedIn</a>
                    <a href="/auth/github" class="oauth-github"><i class="fab fa-github"></i> GitHub</a>
                 </div>
                 <p style="margin-top: 1.5rem;">Don't have an account? <a href="/signup">Sign Up</a></p>
                 </div>
        </div>
    </main>

    <%- include('partials/footer') %>
    <script src="/js/script.js"></script> 
</body>
</html>
