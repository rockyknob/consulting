<nav class="navbar">
    <a href="/" class="navbar-brand">ZAlpha</a> 

    <div class="nav-links">
        <a href="/#home">Home</a> 

       

        <div class="nav-item dropdown">
             <a href="/#products" class="nav-link dropdown-toggle">Products</a>
             <ul class="dropdown-menu">
                  <% if (typeof content !== 'undefined' && content.products && content.products.length > 0) { %>
                     <% content.products.forEach(product => { %>
                         <%
                           let targetUrl = '/#' + (product.link || 'products'); // Default to section
                           let newTab = false;
                           if (product.id === 'prod_ai_analyzer') { targetUrl = '/financial-analyzer'; newTab = true; }
                           if (product.id === 'prod_startup_consult') { targetUrl = '/startup-consultation'; newTab = true; }
                           if (product.id === 'prod_custom_solution') { targetUrl = '/custom-consulting'; newTab = true; }
                         %>
                         <li>
                             <a class="dropdown-item"
                                href="<%= targetUrl %>"
                                <%- (newTab ? 'target="_blank" rel="noopener noreferrer"' : '') %>>
                                <%= product.name %>
                             </a>
                         </li>
                     <% }); %>
                  <% } else { %>
                      <li><a class="dropdown-item" href="/#products">View Products</a></li>
                  <% } %>
             </ul>
         </div>
        <a href="/#services">Why Us</a>
        <a href="/#clients">Clients</a>
        <a href="/#contact" class="nav-cta-button">Contact Us</a>
        <% if (isAuthenticated && currentUser) { %>
            
            <a href="/dashboard">Dashboard</a>
            <a href="/profile">Profile</a>
             <span style="margin-left: 1rem; color: var(--text-medium); font-size: 0.9em; border-left: 1px solid var(--border-color); padding-left: 1rem;">
                 <%= currentUser.displayName || 'User' %>
             </span>
            <a href="/logout" class="nav-cta-button" style="margin-left: 1rem; background-color: var(--text-light);">Logout</a>

        <% } else { %>
            
            

            
             <div class="nav-item dropdown">
                 <a href="#" class="nav-link dropdown-toggle nav-cta-button" style="margin-left: 1rem;">Sign In</a>
                 <ul class="dropdown-menu" style="left: auto; right: 0; min-width: 220px;">
                     <li><a class="dropdown-item" href="/login"><i class="fas fa-envelope" style="margin-right: 8px;"></i> Sign in with Email</a></li>
                     <li><hr class="dropdown-divider" style="margin: 0.3rem 0; border-color: var(--border-color-light);"></li>
                     <li><a class="dropdown-item" href="/auth/google"><i class="fab fa-google" style="margin-right: 8px; color: #db4437;"></i> Sign in with Google</a></li>
                     <li><a class="dropdown-item" href="/auth/linkedin"><i class="fab fa-linkedin" style="margin-right: 8px; color: #0e76a8;"></i> Sign in with LinkedIn</a></li>
                     <li><a class="dropdown-item" href="/auth/github"><i class="fab fa-github" style="margin-right: 8px; color: #333;"></i> Sign in with GitHub</a></li>
                     <li><hr class="dropdown-divider" style="margin: 0.3rem 0; border-color: var(--border-color-light);"></li>
                     <li><a class="dropdown-item" href="/signup" style="font-weight: 500;">Create Account</a></li>
                 </ul>
            </div>
        <% } %>

    </div>
    <button id="mobile-menu-toggle" style="display: none;">☰</button>
</nav>