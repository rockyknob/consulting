<div class="section" id="services">
    <h2>Our Expertise</h2>
    <p class="text-center" style="max-width: 700px; margin: -2rem auto 4rem auto;">
        We combine deep industry knowledge with functional expertise to help you navigate complex challenges and achieve tangible results.
    </p>

    
    <% if (typeof services !== 'undefined' && services.length > 0) { %>
        <% services.forEach((service, index) => { %>
            >
            <div class="feature-section <% if (index % 2 !== 0) { %>reverse<% } %>">

               
                <div class="feature-text animate">
                    <h3><%= service.title %></h3>
                    <p><%= service.description %></p>
                    <div style="margin-top: 1.5rem;">
                         
                        <a href="#contact" class="button button-secondary">Learn More</a>
                    </div>
                </div>

                
                <div class="feature-image animate">
                    <% if (service.title === 'Strategy Development') { %>
                        <div class="strategy-animation-container">
                            <div class="platform-window">
                                <div class="platform-header">
                                    <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
                                    
                                </div>
                                <div class="platform-body">
                                    <div class="chart-area">
                                        <div class="viz bar-chart">
                                            <span class="label">Growth</span>
                                            <div class="bar" style="--bar-height: 70%; --bar-delay: 0.1s; --bar-color: var(--google-green);"></div>
                                            <div class="bar" style="--bar-height: 45%; --bar-delay: 0.2s; --bar-color: var(--google-blue);"></div>
                                            <div class="bar" style="--bar-height: 60%; --bar-delay: 0.3s; --bar-color: var(--google-yellow);"></div>
                                            <div class="bar" style="--bar-height: 80%; --bar-delay: 0.4s; --bar-color: var(--google-red);"></div>
                                        </div>
                                        <div class="viz line-chart">
                                            <span class="label">Analysis</span>
                                            <svg viewBox="0 0 100 50" preserveAspectRatio="none">
                                                <polyline points="0,40 20,15 40,25 60,10 80,20 100,5" class="line"/>
                                            </svg>
                                        </div>
                                    </div>
                                    <div class="kpi-area">
                                        <div class="kpi-card"><span>Market Share</span><strong class="kpi-value">43%</strong></div>
                                        <div class="kpi-card"><span>Profit Margin</span><strong class="kpi-value">+43%</strong></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    <% } else if (service.title === 'Digital Transformation') { %>
                         
                        <div class="digital-animation-container">
                            <div class="datacenter-bg"></div> 
                            <svg class="process-flow-svg" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet">
                                <defs>
                                    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="0" refY="3.5" orient="auto"><polygon points="0 0, 10 3.5, 0 7" fill="var(--text-medium)" /></marker>
                                </defs>
                                
                                <line class="flow-line line1" x1="70" y1="50" x2="130" y2="100" marker-end="url(#arrowhead)" />
                                <line class="flow-line line2" x1="170" y1="100" x2="230" y2="50" marker-end="url(#arrowhead)" />
                                <line class="flow-line line3" x1="270" y1="50" x2="330" y2="100" marker-end="url(#arrowhead)" />
                                
                                <g transform="translate(50, 50)"> <circle cx="0" cy="0" r="25" class="node-circle"/><text class="node-icon business-icon" x="0" y="0" dy="0.1em">&#xf0b1;</text> </g><text class="node-label" x="50" y="85">Business</text>
                                <g transform="translate(150, 100)"> <circle cx="0" cy="0" r="25" class="node-circle"/><text class="node-icon analytics-icon" x="0" y="0" dy="0.1em">&#xf201;</text> </g><text class="node-label" x="150" y="135">Analytics</text>
                                <g transform="translate(250, 50)"> <circle cx="0" cy="0" r="25" class="node-circle"/><text class="node-icon ml-icon" x="0" y="0" dy="0.1em">&#xf544;</text> </g><text class="node-label" x="250" y="85">AI / ML</text>
                                <g transform="translate(350, 100)"> <circle cx="0" cy="0" r="25" class="node-circle"/><text class="node-icon scale-icon" x="0" y="0" dy="0.1em">&#xf5fd;</text> </g><text class="node-label" x="350" y="135">Scale</text> <%# Changed icon to layer-group %>
                            </svg>
                        </div>

                    <% } else if (service.title === 'Performance and Cost Optimization') { %>
                        
                        <div class="performance-animation-container">
                            
                            <div class="retail-bg"></div>
        
                           
                            <div class="perf-icons-wrapper">
                                <div class="perf-icon-group input-icons">
                                     <i class="fas fa-box-open animate-pop" style="--delay: 0.1s;"></i>
                                     <i class="fas fa-cubes animate-pop" style="--delay: 0.3s;"></i>
                                     <span class="perf-label">Products & Services</span>
                                </div>
        
                                <div class="perf-icon-group output-icons">
                                    <div class="output-item">
                                         <i class="fas fa-tachometer-alt animate-up" style="--delay: 0.5s;"></i>
                                        <span class="perf-label">Efficiency <i class="fas fa-arrow-up" style="color: var(--google-green); font-size: 0.8em;"></i></span>
                                    </div>
                                     <div class="output-item">
                                         <i class="fas fa-dollar-sign animate-down" style="--delay: 0.7s;"></i>
                                         <span class="perf-label">Costs <i class="fas fa-arrow-down" style="color: var(--google-red); font-size: 0.8em;"></i></span>
                                     </div>
                                </div>
        
                                
                                <div class="perf-connector"></div>
        
                            </div>
                        </div>
                         
                         
                    <% } %>
                </div>

            </div> 

            
            <% if (index < services.length - 1) { %>
                <hr style="border: none; border-top: 1px solid var(--border-color-light); margin: 5rem auto; max-width: 300px;">
            <% } %>

        <% }); %>
    <% } else { %>
        <p class="text-center">Service information currently unavailable.</p>
    <% } %>
</div>
